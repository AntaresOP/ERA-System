# Core API Settings
PROJECT_NAME="ERA System"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"

# LLM & Embedding Settings (Defaulting to Local via Ollama/HuggingFace)
USE_LOCAL_MODELS=True
LLM_PROVIDER="ollama"             # Options: "ollama", "openai"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# OpenAI Configuration (Fallback/Optional)
OPENAI_API_KEY="sk-proj-mock-key-for-development"
OPENAI_MODEL="gpt-4o-mini"

# Embedding Models
DENSE_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Vector Store (ChromaDB / Qdrant)
VECTOR_STORE_TYPE="chroma"       # Options: "chroma", "qdrant"
CHROMA_PERSIST_DIRECTORY="./data/chroma"
QDRANT_HOST="localhost"
QDRANT_PORT=6333

# Cache Configuration (Redis)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
SEMANTIC_CACHE_THRESHOLD=0.88    # Cosine similarity cutoff threshold

# Reranker Settings
FLASHRANK_MODEL="ms-marco-MiniLM-L-12-v2"